        "SESSION_STATUS_FIX_PROPOSED",
        "SESSION_STATUS_AWAITING_APPROVAL",
        "SESSION_STATUS_FIX_EXECUTING",
        "SESSION_STATUS_VERIFYING",
        "SESSION_STATUS_RESOLVED",
        "SESSION_STATUS_ROLLED_BACK",
        "SESSION_STATUS_FIX_SUGGESTED",
        "SESSION_STATUS_REJECTED",
        "SESSION_STATUS_FAILED",
        "SESSION_STATUS_IGNORED"
