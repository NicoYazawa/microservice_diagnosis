              "SESSION_STATUS_ROLLED_BACK",
              "SESSION_STATUS_FIX_SUGGESTED",
              "SESSION_STATUS_REJECTED",
              "SESSION_STATUS_FAILED",
              "SESSION_STATUS_IGNORED"
