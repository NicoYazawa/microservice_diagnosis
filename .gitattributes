# Normalize line endings for cross-platform collaboration.
* text=auto

# Deterministic LF for text formats across all platforms.
*.go     text eol=lf
*.mod    text eol=lf
*.sum    text eol=lf
*.proto  text eol=lf
*.yaml   text eol=lf
*.yml    text eol=lf
*.sql    text eol=lf
*.json   text eol=lf
*.md     text eol=lf
*.ps1    text eol=lf
Makefile text eol=lf
.gitignore text eol=lf

# Binary assets.
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
